{
  "name": "client-everythingstar-foss-happypaul55-com",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist"
  },
  // Custom domains are managed in the Cloudflare dashboard. Explicitly disable the
  // workers.dev route and version preview URLs so neither is re-enabled on deploy.
  // Branch previews are served from <branch>.everythingstar-foss.happypaul55.com,
  // because the custom domain is enabled for preview traffic.
  "workers_dev": false,
  "preview_urls": false,
  // A Workers Builds branch preview runs `wrangler preview`, which requires the
  // block even when there is nothing preview-specific in it.
  "previews": {}
}
