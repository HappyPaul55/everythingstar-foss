---
import "../styles/global.css";
import Mark from "../components/Mark.astro";
import { PLAYLIST_URL } from "../lib/raw";
import { addPlaylistLink } from "../lib/game";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A free, non-commercial library of UltraStar songs converted for EverythingStar and Guitar Hero-compatible players, with separated stems and licence details on every song page.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL("/icons/android-chrome-512x512.png", Astro.site ?? Astro.url);
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "") || "/";
const year = new Date().getFullYear();
const domain = "everythingstar-foss.happypaul55.com";
const gameUrl = "https://everythingstar.happypaul55.com";

const nav = [
  { href: "/songs", label: "Songs" },
  { href: PLAYLIST_URL, label: "Playlist JSON" },
];
const pill = {
  href: addPlaylistLink(PLAYLIST_URL),
  label: "Add to EverythingStar",
};

const isExternal = (href: string) => /^https?:\/\//.test(href);
const isActive = (href: string) =>
  !isExternal(href) && (path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0c0d0a" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/brand-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/permanent-marker-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header id="site-header" class="site-header on-ink">
      <div class="hazard hazard--thin" aria-hidden="true"></div>
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="EverythingStar FOSS home">
          <Mark size={30} />
          <span class="brand__name">EverythingStar <span class="brand__foss">FOSS</span></span>
        </a>

        <nav class="nav-links nav-links--bar" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                target={isExternal(item.href) ? "_blank" : undefined}
                rel={isExternal(item.href) ? "noopener noreferrer" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a
            class="nav-pill"
            href={pill.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {pill.label} <span aria-hidden="true">↗</span>
          </a>
        </nav>

        <details class="nav-disclosure">
          <summary class="nav-toggle" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 7h16M4 12h16M4 17h16"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
          </summary>
          <nav class="nav-links nav-links--panel" aria-label="Primary">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  target={isExternal(item.href) ? "_blank" : undefined}
                  rel={isExternal(item.href) ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a
              class="nav-pill"
              href={pill.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {pill.label} <span aria-hidden="true">↗</span>
            </a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer on-ink">
      <div class="hazard" aria-hidden="true"></div>
      <div class="container site-footer__body">
        <div class="site-footer__grid">
          <div>
            <a class="site-footer__brand" href="/">
              <Mark size={30} />
              <span>EverythingStar</span>
            </a>
            <p class="site-footer__tagline">
              A free, non-commercial song library for rhythm-based games like{" "}
              <a href={gameUrl} target="_blank" rel="noopener noreferrer">EverythingStar</a>.
            </p>
          </div>

          <nav aria-label="Footer pages">
            <h2 class="site-footer__heading">Pages</h2>
            <ul class="site-footer__links">
              <li><a href="/songs">Songs</a></li>
              <li>
                <a href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer"
                  >Playlist JSON</a
                >
              </li>
            </ul>
          </nav>

          <div>
            <h2 class="site-footer__heading">Elsewhere</h2>
            <ul class="site-footer__links">
              <li>
                <a href={gameUrl} target="_blank" rel="noopener noreferrer"
                  >Play with EverythingStar <span aria-hidden="true">↗</span></a
                >
              </li>
              <li><a href="/ATTRIBUTION.md">Attribution</a></li>
              <li>
                <a href="https://www.happypaul55.com" target="_blank" rel="noopener noreferrer"
                  >HappyPaul55 ↗</a
                >
              </li>
            </ul>
          </div>
        </div>

        <div class="site-footer__bottom">
          <span>
            © {year}{" "}
            <a href="https://www.happypaul55.com" target="_blank" rel="noopener noreferrer"
              >HappyPaul55</a
            >{" "}· {domain}
          </span>
          <span class="site-footer__note">// non-commercial · no accounts, no cookies, no trackers</span>
        </div>
      </div>
    </footer>
  </body>
</html>
